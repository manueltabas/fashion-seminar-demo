# PostgreSQL connection string used by the app and by drizzle-kit.
# Local example (Homebrew postgresql@17): postgres://<user>@localhost:5432/fashion_seminar_demo
DATABASE_URL=postgres://user@localhost:5432/fashion_seminar_demo

# Shared password gate for the MVP (replace with real auth later).
APP_PASSWORD=change-me

# Model provider keys. Only Google (Gemini) is configured for now.
GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Per-evaluation cost guardrails (0 disables the cost ceiling).
MAX_MODELS_PER_EVALUATION=3
MAX_EVALUATION_COST_USD=1
ASSUMED_INPUT_TOKENS=20000
ASSUMED_OUTPUT_TOKENS=2000
